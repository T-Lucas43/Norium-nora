ARG NORIUM_RUNTIME_BASE=ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

FROM node:24-alpine AS frontend-build

WORKDIR /build/frontend
COPY norium-front-end/package.json norium-front-end/package-lock.json ./
RUN npm ci
COPY norium-front-end/ ./
RUN npm run build

# Build the Python environment on the same signed distribution used at runtime.
# Only the populated venv is copied: pip/ensurepip and build tools stay out of
# the final image, while installed dependency metadata remains available to SCA.
FROM ${NORIUM_RUNTIME_BASE} AS backend-build
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates python3.14 python3.14-venv \
    && rm -rf /var/lib/apt/lists/*
COPY norium-back-end/requirements.lock.txt /build/requirements.lock.txt
RUN python3.14 -m venv /opt/norium-venv \
    && /opt/norium-venv/bin/python -m pip install --no-cache-dir -r /build/requirements.lock.txt \
    && /opt/norium-venv/bin/python -m pip check \
    && /opt/norium-venv/bin/python -m pip uninstall --yes pip

FROM ${NORIUM_RUNTIME_BASE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV NORIUM_DATA_DIR=/app/data
ENV NORIUM_SPA_DIR=/opt/norium/static
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV NORIUM_BROWSER_CHANNEL=chrome
ENV HOME=/home/norium
ENV XDG_CONFIG_HOME=/home/norium/.config
ENV XDG_CACHE_HOME=/home/norium/.cache
ENV PORT=8000
ENV PATH=/opt/norium-venv/bin:${PATH}

# ShardCloud mounts the persistent application data under /app. Keep the
# immutable runtime elsewhere so the mount cannot hide main.py or app/.
WORKDIR /opt/norium

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates python3.14 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 norium \
    && useradd --uid 10001 --gid norium --no-create-home --shell /usr/sbin/nologin norium

COPY --from=backend-build /opt/norium-venv /opt/norium-venv

# Use the official, patched stable Chrome package. The bundled Playwright
# Chromium is older than the current vendor security fixes. Verify the exact
# official package bytes before installation; keep the application sandbox.
RUN python - <<'PY'
import hashlib
import pathlib
import urllib.request

version = "154.0.8037.97-1"
expected_bytes = 142172388
expected_sha256 = "a4edbe95e9b01db6c9b97d7a1323121eda18362b5620df06abac1b59bee80053"
target = pathlib.Path("/tmp/norium-google-chrome-stable.deb")
url = "https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_" + version + "_amd64.deb"
digest = hashlib.sha256()
received = 0
with urllib.request.urlopen(url, timeout=120) as response, target.open("xb") as stream:
    while chunk := response.read(1024 * 1024):
        received += len(chunk)
        if received > expected_bytes:
            raise SystemExit("Official browser package exceeds its pinned size")
        digest.update(chunk)
        stream.write(chunk)
if received != expected_bytes or digest.hexdigest() != expected_sha256:
    raise SystemExit("Official browser package integrity check failed")
print("official_browser_package_sha256_verified:", expected_sha256)
PY
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/norium-google-chrome-stable.deb \
    && test "$(dpkg-query -W -f='${Version}' google-chrome-stable)" = '154.0.8037.97-1' \
    && rm /tmp/norium-google-chrome-stable.deb \
    && rm -rf /var/lib/apt/lists/*

# Fail closed if a future distribution dependency reintroduces installers.
# The runtime does not install python3.14-venv, python3-pip or wheel packages.
RUN python - <<'PY'
import importlib.util
import sys

if sys.version_info[:2] != (3, 14):
    raise SystemExit("Unexpected runtime Python version")
for module in ("pip", "ensurepip"):
    if importlib.util.find_spec(module) is not None:
        raise SystemExit("Installation tool remains available: " + module)
print("runtime_installation_tools_removed: pip and ensurepip")
PY

COPY norium-back-end/app ./app
COPY norium-back-end/main.py ./main.py
COPY norium-back-end/scripts/migrate_oauth_credentials.py ./scripts/migrate_oauth_credentials.py
COPY --from=frontend-build /build/frontend/dist ./static

# Fail the build if the trusted PostgreSQL CA bundle is missing or malformed.
RUN python -c "import ssl; ssl.create_default_context(cafile='/opt/norium/app/infrastructure/persistence/azure_postgres_roots.pem')"

# Full Chromium needs writable configuration directories for Crashpad at startup.
RUN mkdir -p /app/data /home/norium/.config /home/norium/.cache \
    && chown -R norium:norium /app/data /home/norium
USER norium

# BuildKit does not provide the runtime user namespaces needed by Chromium.
# Check the bundle here; CI and platform promotion still require the real DOM
# smoke with sandbox, under the final runtime identity and security policy.
RUN python -m app.infrastructure.browser_runtime_smoke --inventory-only

# Keep the unprivileged identity for the final runtime. Sandbox and binding to
# the injected port must pass on the platform before this image is promoted.

ARG NORIUM_RELEASE_SHA=""
ENV NORIUM_RELEASE_SHA=${NORIUM_RELEASE_SHA}

EXPOSE 80 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"

CMD ["sh", "-c", "exec uvicorn --app-dir /opt/norium main:app --host 0.0.0.0 --port ${PORT:-80} --workers 1 --ws-max-size 120000 --ws-max-queue 8 --proxy-headers"]
