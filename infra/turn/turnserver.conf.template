# REVIEW ONLY: valores inválidos deliberados; nunca copiar direto para /etc.
# Perfil de opções: https://github.com/coturn/coturn/blob/4.6.1/examples/etc/turnserver.conf
listening-ip=__PUBLIC_IPV4_ON_HOST__
relay-ip=__PUBLIC_IPV4_ON_HOST__
tls-listening-port=5349
no-udp
no-tcp
no-dtls
no-tcp-relay
no-tlsv1
no-tlsv1_1
no-rfc5780
no-stun-backward-compatibility
no-stun
fingerprint
use-auth-secret
static-auth-secret=__GENERATE_EXCLUSIVE_SECRET_ONLY_ON_HOST__
realm=__TURN_FQDN__
cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem
stale-nonce=600
min-port=50000
max-port=50199
total-quota=100
user-quota=4
max-bps=1000000
bps-capacity=12500000
proc-user=turnserver
proc-group=turnserver
no-cli
web-admin=0
syslog
no-stdout-log
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
