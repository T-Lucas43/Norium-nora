# Ambiente
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
NORIUM_DATA_DIR=

# Vercel (configure no painel, nao neste arquivo):
# ENVIRONMENT=production
# FRONTEND_URL=https://seu-projeto.vercel.app
# BACKEND_PUBLIC_URL=https://seu-projeto.vercel.app
# Deixe NORIUM_DATA_DIR vazio: a pre-visualizacao usa /tmp/norium, que e temporario.

# Autenticacao
NORIUM_AUTH_SECRET=
NORIUM_OWNER_PASSWORD=

# Nora
GROQ_API_KEY=
NORA_MODEL=openai/gpt-oss-20b
NORA_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound-mini
NORA_INTENT_LLM=1
NORA_TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integracoes/google/callback
# Producao: https://seu-projeto.vercel.app/api/integracoes/google/callback

# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/callback/gmail
# Producao: https://seu-projeto.vercel.app/api/auth/callback/gmail

# WhatsApp Z-API
WHATSAPP_INSTANCE_ID=
WHATSAPP_INSTANCE_TOKEN=
WHATSAPP_CLIENT_TOKEN=
WHATSAPP_OWNER_USER_ID=lucas123
# Configure o mesmo valor secreto no provedor do webhook. Nunca use userId do payload para escolher o tenant.
WHATSAPP_WEBHOOK_SECRET=
# Hosts HTTPS extras de CDN do provedor, separados por virgula. O host principal da instancia ja e aceito.
WHATSAPP_MEDIA_HOSTS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_EMAIL=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Consulta de boletos
SAMIERP_ID_PARCEIRO=
SAMIERP_SIGLA=
SAMIERP_SENHA=
SAMIERP_BOLETO_URL=
