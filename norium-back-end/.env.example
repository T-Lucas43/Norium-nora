# Ambiente
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
NORIUM_DATA_DIR=

# Vercel (configure no painel, nao neste arquivo):
# ENVIRONMENT=production
# FRONTEND_URL=https://seu-projeto.vercel.app
# BACKEND_PUBLIC_URL=https://seu-projeto.vercel.app
# Deixe NORIUM_DATA_DIR vazio: a pre-visualizacao usa /tmp/norium, que e temporario.

# Autenticacao
NORIUM_AUTH_SECRET=
# Shared runtimes require the existing signing secret in the secret manager.
# Preserve its current value: other existing encrypted settings may depend on it.
# Generate the dedicated OAuth Fernet key outside AI/chat and keep it in the secret manager.
NORIUM_OAUTH_CREDENTIAL_ENCRYPTION_KEY=
# Previous Fernet keys, comma-separated, for reviewed rotation and recovery.
NORIUM_OAUTH_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
# Enable only after reviewing the critical diff and migration/rollback gates.
# Shared runtimes default to disabled; server-side session validation stays mandatory.
NORIUM_PERSISTENT_SESSIONS_ENABLED=false
# Bootstrap de uso unico: os quatro valores sao obrigatorios e so sao lidos quando
# usuarios_db.json ainda nao existe. Um arquivo existente, mesmo vazio/invalido,
# bloqueia o bootstrap; estas variaveis nunca promovem contas em cadastro/leitura/gravacao.
# Remova a senha do ambiente imediatamente depois de validar o primeiro acesso.
NORIUM_BOOTSTRAP_ADMIN_EMAIL=
NORIUM_BOOTSTRAP_ADMIN_USER_ID=
NORIUM_BOOTSTRAP_ADMIN_NAME=
NORIUM_BOOTSTRAP_ADMIN_PASSWORD=

# Conectividade WebRTC de chamadas (segredo somente no backend)
# Em ambientes que devem suportar redes restritivas, use true e forneça
# um servidor compatível com TURN REST, incluindo ao menos uma URL turns:.
# Local defaults below. Production/shared runtime defaults are disabled/0%.
# Azure launch profile: enabled=true, percent=0, explicit internal test teams,
# recording=false, SFU=false, TURN required with exclusive turns: TLS/443.
# GitHub deployment profile defaults public. Explicit internal-test defers only
# the external requirements listed in docs/operations/team-call-public-launch-checklist.md.
TEAM_CALL_RELEASE_PROFILE=public
TEAM_CALL_ENABLED=true
TEAM_CALL_ROLLOUT_PERCENT=100
TEAM_CALL_INTERNAL_TEAMS=
TEAM_CALL_RECORDING_ENABLED=true
TEAM_CALL_MAX_ACTIVE_PER_TEAM=8
TEAM_CALL_MAX_ACTIVE_TOTAL=100
TEAM_CALL_MAX_SOCKETS=1000
TEAM_CALL_MAX_SOCKETS_PER_TEAM=100
TEAM_CALL_MAX_SOCKETS_PER_USER=4
# Runtime-only scrape bearer secret, >=32 ASCII chars; empty disables endpoint.
TEAM_CALL_METRICS_TOKEN=
# Release preflight only: fill after verified collection/alert delivery.
# Keep false/empty until a concrete HTTPS evidence record exists.
TEAM_CALL_METRICS_COLLECTOR_READY=false
TEAM_CALL_ALERT_RECEIVER_READY=false
TEAM_CALL_ALERT_TEST_DELIVERED=false
TEAM_CALL_OBSERVABILITY_EVIDENCE_URL=
TEAM_CALL_TURN_REQUIRED=false
TEAM_CALL_MESH_MAX_PARTICIPANTS=6
TEAM_CALL_SFU_ENABLED=false
TEAM_CALL_LIVEKIT_URL=
TEAM_CALL_LIVEKIT_API_KEY=
TEAM_CALL_LIVEKIT_API_SECRET=
TEAM_CALL_SFU_TOKEN_TTL_SECONDS=300
TEAM_CALL_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TEAM_CALL_TURN_URLS=
TEAM_CALL_TURN_SHARED_SECRET=
TEAM_CALL_TURN_TTL_SECONDS=600
TEAM_CALL_TURN_REFRESH_MARGIN_SECONDS=120

# Gravacoes de chamadas de equipe (limites impostos no servidor)
TEAM_RECORDING_MAX_CHUNK_BYTES=16777216
TEAM_RECORDING_MAX_TOTAL_BYTES=536870912
TEAM_RECORDING_MAX_DURATION_SECONDS=21600
TEAM_RECORDING_MAX_CONCURRENT_PER_TEAM=2
TEAM_RECORDING_MAX_TEAM_BYTES=2147483648
TEAM_RECORDING_REQUEST_LIMIT=60
TEAM_RECORDING_REQUEST_WINDOW_SECONDS=60
TEAM_RECORDING_RETENTION_HOURS=24
TEAM_RECORDING_MAINTENANCE_INTERVAL_SECONDS=60
TEAM_RECORDING_ORPHAN_GRACE_SECONDS=600

# Nora
# `auto` prefere OpenAI Responses quando OPENAI_API_KEY existe e preserva o
# runtime Groq como fallback de configuração. A assinatura ChatGPT não inclui
# automaticamente uma chave da API.
NORA_PROVIDER=auto
NORA_OPENAI_MODEL=gpt-6-astra
NORA_OPENAI_FALLBACK_MODELS=gpt-6-sol
GROQ_API_KEY=
NORA_MODEL=openai/gpt-oss-20b
NORA_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
NORA_INTENT_LLM=1
# edge | elevenlabs | auto (auto usa ElevenLabs quando houver chave). Falhas da ElevenLabs caem na voz Edge.
NORA_TTS_PROVIDER=auto
ELEVENLABS_API_KEY=""
# Vazio = Alice (Xb7hH8MSUJpSbSDYk0k2), mesma voz do video de divulgacao.
ELEVENLABS_VOICE_ID=
# Modelo de baixa latencia para fala em tempo real.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Cérebro durável da Nora (desativado enquanto estes valores estiverem vazios)
# Em produção, use PostgreSQL e injete os segredos pelo gerenciador do provedor.
NORA_BRAIN_DATABASE_URL=
# Em produção, mantenha verify-full (ou verify-ca com CA explicitamente gerenciada).
NORA_BRAIN_DB_SSLMODE=verify-full
NORA_BRAIN_PROVIDER=openai
OPENAI_API_KEY=
NORA_BRAIN_ROUTINE_MODEL=gpt-6-sol
NORA_BRAIN_DOCUMENT_MODEL=gpt-6-astra
NORA_BRAIN_ALLOW_MODEL_CALLS=0
# Somente no Container App do executor separado:
NORA_BRAIN_EXECUTOR_ENABLED=0
# URL base do processo web, sem o caminho /api. Obrigatória no executor.
NORA_BRAIN_INTERNAL_URL=http://127.0.0.1:8000
# Mesmo segredo aleatório de no mínimo 32 caracteres no web e no executor.
NORA_BRAIN_INTERNAL_SECRET=
# O web atual precisa permanecer com uma réplica/um worker enquanto grava JSON legado.
NORA_LEGACY_WRITER_SINGLETON=0

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integracoes/google/callback
# Producao: https://seu-projeto.vercel.app/api/integracoes/google/callback

# Nora em reuniões — núcleo parcial; não inicia agente operacional sozinho.
# Requer revisão de perfil SFU, entitlement nora_reunioes, supervisor e LGPD.
NORA_CALL_ENABLED=0
NORA_CALL_MAX_CONCURRENT=2
NORA_CALL_CHUNK_SECONDS=10
# GROQ_API_KEY permanece exclusivamente no backend.
# Alice ainda deve ser confirmada no catálogo da conta; o supervisor não
# carrega um ID operacional de voz neste estágio.

# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/callback/gmail
# Producao: https://seu-projeto.vercel.app/api/auth/callback/gmail

# --- WhatsApp via W-API (integração ativa) ---
# Base oficial da API (ex.: https://api.w-api.app). O cliente sempre usa /v1.
WAPI_BASE_URL=https://api.w-api.app
# API Key Mestra da conta (cria/gerencia instâncias). SEGREDO — só no backend.
WAPI_MASTER_API_KEY=
# Chave Fernet (32 bytes em base64 URL-safe) usada somente para tokens de instância.
# Obrigatória fora de test/testing; gere no gerenciador de segredos, nunca no código.
WAPI_CREDENTIAL_ENCRYPTION_KEY=
# Durante rotação, liste aqui as chaves antigas separadas por vírgula. São usadas
# apenas para leitura e devem ser removidas após o sweep documentado.
WAPI_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
# Segredo que valida os webhooks recebidos (viaja na URL registrada ?secret=).
# Obrigatório em todo ambiente não local/teste; valor ausente, vazio ou com
# whitespace ou caracteres fora de ASCII interrompe o startup.
WAPI_WEBHOOK_SECRET=
# Homologação: somente em ENVIRONMENT local/development/dev/test/testing.
# Exige o tenant autorizado explicitamente e vincula apenas essa conta à instância
# existente, sem create-instance. As três variáveis devem ficar vazias em qualquer
# ambiente compartilhado (production/prod/railway/staging etc.).
WAPI_TEST_TENANT_ID=
WAPI_TEST_INSTANCE_ID=
WAPI_TEST_INSTANCE_TOKEN=
# Hosts HTTPS extras de CDN de mídia, separados por vírgula (o host da API já é aceito).
WHATSAPP_MEDIA_HOSTS=

# Ajustes de cache/limites do chat (opcionais):
# WHATSAPP_CATALOG_CACHE_TTL_SECONDS=  WHATSAPP_HISTORY_CACHE_TTL_SECONDS=
# WHATSAPP_RECENT_CONVERSATION_LIMIT=  WHATSAPP_RECENT_DAYS=

# Consulta de boletos
SAMIERP_ID_PARCEIRO=
SAMIERP_SIGLA=
SAMIERP_SENHA=
SAMIERP_BOLETO_URL=

# Central de Documentos
# Cotas cumulativas da camada compartilhada de arquivos (bytes). São verificadas
# também em Clientes/Documentos; PostgreSQL serializa a conta e a gravação.
NORIUM_STORAGE_GLOBAL_QUOTA_BYTES=4294967296
NORIUM_STORAGE_WORKSPACE_QUOTA_BYTES=536870912
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_PROCESS_TIMEOUT_SECONDS=240
DOCUMENT_PROCESS_MAX_RETRIES=1
# Opcional: instancia Stirling PDF isolada. Sem URL, as ferramentas nativas
# continuam ativas e operacoes externas como OCR nao sao anunciadas na interface.
STIRLING_PDF_URL=
STIRLING_PDF_API_KEY=
STIRLING_PDF_TIMEOUT_SECONDS=180

# E-mail transacional Hostinger. Preferencialmente configure a senha em
# Administracao > E-mails > E-mail do sistema (criptografada no servidor).
# Alternativa: injetar pelo gerenciador de segredos, nunca pelo frontend/Git.
# Remetente fixo: suporte@norium-ai.com; SMTP SSL: smtp.hostinger.com:465.
NORIUM_SMTP_PASSWORD=

# Fase6: opt-in; never enable workers in homologation as part of a code-only update.
NORA_BRAIN_ENABLED=0
NORA_OPENAI_MODEL=gpt-5.6-luna
NORA_OPENAI_DOCUMENT_MODEL=gpt-5.6-sol
NORA_KNOWLEDGE_EMBEDDINGS_ENABLED=0
NORIUM_GMAIL_INCREMENTAL_ENABLED=0
NORIUM_BRAVE_ENABLED=1
BRAVE_SEARCH_API_KEY=

# Fila interna do Chat da equipe: opt-in, um único escritor, intervalo >= 60 s.
NORIUM_TEAM_CHAT_QUEUE_ENABLED=0
