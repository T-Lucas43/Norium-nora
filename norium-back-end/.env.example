# Ambiente
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
NORIUM_DATA_DIR=

# Vercel (configure no painel, nao neste arquivo):
# ENVIRONMENT=production
# FRONTEND_URL=https://seu-projeto.vercel.app
# BACKEND_PUBLIC_URL=https://seu-projeto.vercel.app
# Deixe NORIUM_DATA_DIR vazio: a pre-visualizacao usa /tmp/norium, que e temporario.

# Autenticacao
NORIUM_AUTH_SECRET=
# Somente para inicializar uma instalacao vazia. Remova a senha do ambiente apos o primeiro acesso.
NORIUM_BOOTSTRAP_ADMIN_EMAIL=
NORIUM_BOOTSTRAP_ADMIN_USER_ID=norium-admin
NORIUM_BOOTSTRAP_ADMIN_NAME=Administrador Norium
NORIUM_BOOTSTRAP_ADMIN_PASSWORD=

# Conectividade WebRTC de chamadas (segredo somente no backend)
# Em ambientes que devem suportar redes restritivas, use true e forneça
# um servidor compatível com TURN REST, incluindo ao menos uma URL turns:.
TEAM_CALL_TURN_REQUIRED=false
TEAM_CALL_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TEAM_CALL_TURN_URLS=
TEAM_CALL_TURN_SHARED_SECRET=
TEAM_CALL_TURN_TTL_SECONDS=600
TEAM_CALL_TURN_REFRESH_MARGIN_SECONDS=120

# Gravacoes de chamadas de equipe (limites impostos no servidor)
TEAM_RECORDING_MAX_CHUNK_BYTES=16777216
TEAM_RECORDING_MAX_TOTAL_BYTES=536870912
TEAM_RECORDING_MAX_DURATION_SECONDS=21600
TEAM_RECORDING_MAX_CONCURRENT_PER_TEAM=2
TEAM_RECORDING_MAX_TEAM_BYTES=2147483648
TEAM_RECORDING_REQUEST_LIMIT=60
TEAM_RECORDING_REQUEST_WINDOW_SECONDS=60
TEAM_RECORDING_RETENTION_HOURS=24
TEAM_RECORDING_MAINTENANCE_INTERVAL_SECONDS=60
TEAM_RECORDING_ORPHAN_GRACE_SECONDS=600

# Nora
GROQ_API_KEY=
NORA_MODEL=openai/gpt-oss-20b
NORA_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
NORA_INTENT_LLM=1
NORA_TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integracoes/google/callback
# Producao: https://seu-projeto.vercel.app/api/integracoes/google/callback

# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/callback/gmail
# Producao: https://seu-projeto.vercel.app/api/auth/callback/gmail

# --- WhatsApp via W-API (integração ativa) ---
# Base oficial da API (ex.: https://api.w-api.app). O cliente sempre usa /v1.
WAPI_BASE_URL=https://api.w-api.app
# API Key Mestra da conta (cria/gerencia instâncias). SEGREDO — só no backend.
WAPI_MASTER_API_KEY=
# Chave Fernet (32 bytes em base64 URL-safe) usada somente para tokens de instância.
# Obrigatória fora de test/testing; gere no gerenciador de segredos, nunca no código.
WAPI_CREDENTIAL_ENCRYPTION_KEY=
# Durante rotação, liste aqui as chaves antigas separadas por vírgula. São usadas
# apenas para leitura e devem ser removidas após o sweep documentado.
WAPI_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
# Segredo que valida os webhooks recebidos (viaja na URL registrada ?secret=).
# Obrigatório em todo ambiente não local/teste; valor ausente, vazio ou com
# whitespace ou caracteres fora de ASCII interrompe o startup.
WAPI_WEBHOOK_SECRET=
# Homologação: somente em ENVIRONMENT local/development/dev/test/testing.
# Exige o tenant autorizado explicitamente e vincula apenas essa conta à instância
# existente, sem create-instance. As três variáveis devem ficar vazias em qualquer
# ambiente compartilhado (production/prod/railway/staging etc.).
WAPI_TEST_TENANT_ID=
WAPI_TEST_INSTANCE_ID=
WAPI_TEST_INSTANCE_TOKEN=
# Hosts HTTPS extras de CDN de mídia, separados por vírgula (o host da API já é aceito).
WHATSAPP_MEDIA_HOSTS=

# Ajustes de cache/limites do chat (opcionais):
# WHATSAPP_CATALOG_CACHE_TTL_SECONDS=  WHATSAPP_HISTORY_CACHE_TTL_SECONDS=
# WHATSAPP_RECENT_CONVERSATION_LIMIT=  WHATSAPP_RECENT_DAYS=

# Consulta de boletos
SAMIERP_ID_PARCEIRO=
SAMIERP_SIGLA=
SAMIERP_SENHA=
SAMIERP_BOLETO_URL=

# Central de Documentos
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_PROCESS_TIMEOUT_SECONDS=240
DOCUMENT_PROCESS_MAX_RETRIES=1
# Opcional: instancia Stirling PDF isolada. Sem URL, as ferramentas nativas
# continuam ativas e operacoes externas como OCR nao sao anunciadas na interface.
STIRLING_PDF_URL=
STIRLING_PDF_API_KEY=
STIRLING_PDF_TIMEOUT_SECONDS=180
